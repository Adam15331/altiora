{
  "name": "altiora",
  "private": true,
  "description": "Altiora — static, client-side university course finder. No build step: the site is the files in this repo. These scripts are developer tooling only.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . && node scripts/check-syntax.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node scripts/validate-requirements.mjs",
    "report": "node scripts/requirements-report.mjs",
    "new-cycle": "node scripts/requirements-new-cycle.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run lint && npm run typecheck && npm run validate && npm test",
    "sync-copy": "node scripts/sync-coverage-copy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3"
  }
}
